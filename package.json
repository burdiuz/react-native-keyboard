{
  "name": "@actualwave/react-native-keyboard",
  "version": "0.1.0",
  "description": "Android hardware keyboard for React Native: live presence detection, key events with modifiers, and consuming shortcuts natively. Android only.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "android",
    "react-native.config.js",
    "LICENSE",
    "!android/build",
    "!**/*.spec.ts",
    "!**/.*",
    "CHANGELOG.md",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "android",
    "keyboard",
    "hardware-keyboard",
    "key-events",
    "shortcuts",
    "android-tv",
    "keycode"
  ],
  "author": "Oleg Galaburda <burdiuz@gmail.com> (https://github.com/burdiuz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burdiuz/react-native-keyboard.git"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.0"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/burdiuz/react-native-keyboard/issues"
  },
  "homepage": "https://github.com/burdiuz/react-native-keyboard#readme",
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node10",
            "target": "ES2020",
            "strict": true,
            "skipLibCheck": true,
            "types": []
          },
          "diagnostics": {
            "ignoreCodes": [
              151001
            ]
          }
        }
      ]
    }
  }
}
